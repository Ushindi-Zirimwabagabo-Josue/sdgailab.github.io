---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import CmsText from '../islands/CmsText';
const offers = [
  { section: 'offer-1', icon: 'iterate' },
  { section: 'offer-2', icon: 'chat' },
  { section: 'offer-3', icon: 'nodes' },
  { section: 'offer-4', icon: 'handshake' },
];
const approaches = ['approach-1', 'approach-2', 'approach-3'];
---

<BaseLayout
  title="Services — SDG AI Lab"
  description="What partners can commission from the SDG AI Lab, from an iterative build through to independent operation."
>
  <main class="marina-services" id="main">
    <section class="band services-band" id="services">
      <div class="marina-live-wrap">
        <div class="band-head reveal">
          <h1><CmsText client:load page="services" section="heading" /></h1>
          <p><CmsText client:load page="services" section="intro" /></p>
        </div>
        <div class="offer-stage">
          <h2 class="offer-label">
            <CmsText client:load page="services" section="offer-heading" />
          </h2>
          <div class="offer-grid">
            {
              offers.map((offer, index) => (
                <article
                  class="offer-card reveal"
                  style={`--rd:${index * 70}ms`}
                >
                  <>
                    <div class="offer-icon" aria-hidden="true">
                      {offer.icon === 'iterate' && (
                        <svg viewBox="0 0 24 24">
                          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                          <path d="M21 3v5h-5" />
                          <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                          <path d="M8 16H3v5" />
                        </svg>
                      )}
                      {offer.icon === 'chat' && (
                        <svg viewBox="0 0 24 24">
                          <path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                          <path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1" />
                        </svg>
                      )}
                      {offer.icon === 'nodes' && (
                        <svg viewBox="0 0 24 24">
                          <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
                          <path d="M9 13a4.5 4.5 0 0 0 3-4" />
                          <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5" />
                          <path d="M3.477 10.896a4 4 0 0 1 .585-.396" />
                          <path d="M6 18a4 4 0 0 1-1.967-.516" />
                          <path d="M12 13h4" />
                          <path d="M12 18h6a2 2 0 0 1 2 2v1" />
                          <path d="M12 8h8" />
                          <path d="M16 8V5a2 2 0 0 1 2-2" />
                          <circle cx="16" cy="13" r=".5" />
                          <circle cx="18" cy="3" r=".5" />
                          <circle cx="20" cy="21" r=".5" />
                          <circle cx="20" cy="8" r=".5" />
                        </svg>
                      )}
                      {offer.icon === 'handshake' && (
                        <svg viewBox="0 0 24 24">
                          <path d="m11 17 2 2a1 1 0 1 0 3-3" />
                          <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
                          <path d="m21 3 1 11h-2" />
                          <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
                          <path d="M3 4h8" />
                        </svg>
                      )}
                    </div>
                    <h3>
                      <span class="offer-num">{String(index + 1).padStart(2, '0')}</span>
                      <span aria-hidden="true"> · </span>
                      <CmsText
                        client:load
                        page="services"
                        section={`${offer.section}-title`}
                      />
                    </h3>
                    <p>
                      <CmsText
                        client:load
                        page="services"
                        section={`${offer.section}-body`}
                      />
                    </p>
                  </>
                </article>
              ))
            }
          </div>
          <a class="offer-next" href="#approach" aria-label="Continue to the approach">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </a>
        </div>
      </div>
    </section>
    <section class="band" id="approach">
      <div class="marina-live-wrap">
        <div class="band-head reveal">
          <h2>
            <CmsText client:load page="services" section="approach-heading" />
          </h2>
          <p>
            <CmsText client:load page="services" section="approach-intro" />
          </p>
        </div>
        <div class="approach-grid">
          {
            approaches.map((section, index) => (
              <article
                class="approach-cell reveal"
                style={`--rd:${index * 70}ms`}
              >
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>
                    <CmsText
                      client:load
                      page="services"
                      section={`${section}-title`}
                    />
                  </h3>
                  <p>
                    <CmsText
                      client:load
                      page="services"
                      section={`${section}-body`}
                    />
                  </p>
                </>
              </article>
            ))
          }
        </div>
        <!-- <div class="services-cta reveal">
          <div>
            <h2><CmsText client:load page="services" section="cta-heading" /></h2>
            <p><CmsText client:load page="services" section="cta-body" /></p>
          </div>
          <a
            class="marina-button marina-button--primary"
            href={withBase('/contact')}>Contact</a
          >
        </div> -->
      </div>
    </section>
  </main>
  <style>
    .marina-services {
      --bg: #15181c;
      --raised: #1b1f24;
      --elevated: #21262c;
      --border: #2c323a;
      --soft: #24292f;
      --text: #eef2f6;
      --dim: #c3ccd4;
      --mid: #d7dee6;
      --faint: #aeb7c0;
      --teal: #3ec6e6;
      --blue: #1c61ac;
      --amber: #6ec6e8;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }
    .marina-services * {
      box-sizing: border-box;
    }
    .marina-services .band {
      padding: 56px 0;
      border-bottom: 1px solid var(--soft);
    }
    .marina-services .services-band {
      padding-top: 150px;
    }
    .marina-services .band-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      align-items: start;
      margin-bottom: 72px;
    }
    .marina-services .band-head h1,
    .marina-services .band-head h2 {
      margin: 0;
      background: linear-gradient(115deg, #fff 20%, #a8e6f5 55%, #c5eef8 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: clamp(2.15rem, 4vw, 3.3rem);
      font-weight: 700;
      line-height: 1.06;
      letter-spacing: -0.03em;
    }
    .marina-services .band-head p {
      max-width: 460px;
      margin: 0;
      color: var(--mid);
      font-size: 1.1rem;
      line-height: 1.6;
    }
    .marina-services .reveal {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
      transition:
        opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--rd, 0ms);
    }
    .marina-services .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
    .offer-stage {
      position: relative;
      margin-bottom: 36px;
    }
    .offer-label {
      margin: 0 0 22px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: 1.45rem;
      font-weight: 650;
      letter-spacing: -0.02em;
    }
    .offer-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .offer-card {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding: 26px 26px 28px;
      border: 1px solid var(--soft);
      border-radius: 16px;
      background: var(--raised);
      transition:
        border-color 0.18s ease,
        transform 0.18s ease;
    }
    .offer-card:hover {
      border-color: var(--border);
      transform: translateY(-2px);
    }
    .offer-icon {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      width: 28px;
      height: 28px;
      margin: 0 0 18px;
      color: var(--text);
    }
    .offer-icon svg,
    .offer-next svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .offer-icon svg circle {
      fill: currentColor;
      stroke: none;
    }
    .offer-card h3 {
      margin: 0 0 10px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: 1.12rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.3;
    }
    .offer-num {
      font-variant-numeric: tabular-nums;
    }
    .offer-card p {
      margin: 0;
      max-width: 36rem;
      color: var(--dim);
      font-size: 1rem;
      line-height: 1.55;
    }
    .offer-next {
      position: absolute;
      left: 50%;
      bottom: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--bg);
      color: var(--text);
      transform: translate(-50%, 50%);
      text-decoration: none;
    }
    .offer-next:hover {
      border-color: var(--teal);
      color: var(--teal);
    }
    .approach-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 56px;
    }
    .approach-cell {
      padding-top: 24px;
      border-top: 1px solid var(--soft);
      transition: border-color 0.25s ease;
    }
    .approach-cell:nth-child(1) {
      --approach-accent: #00689d;
    }
    .approach-cell:nth-child(2) {
      --approach-accent: #3f7e44;
    }
    .approach-cell:nth-child(3) {
      --approach-accent: #ff3a21;
    }
    .approach-cell:hover {
      border-top-color: var(--approach-accent, var(--teal));
    }
    .approach-cell > span {
      display: block;
      margin-bottom: 22px;
      color: var(--approach-accent, var(--teal));
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .approach-cell h3 {
      margin: 0 0 14px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: 1.18rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .approach-cell p {
      margin: 0;
      color: var(--dim);
      font-size: 1.02rem;
      line-height: 1.6;
    }
    .services-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      flex-wrap: wrap;
      margin-top: 56px;
      padding: 44px 48px;
      border: 1px solid var(--soft);
      border-radius: 18px;
      background:
        radial-gradient(
          900px 300px at 85% -40%,
          rgba(3, 131, 174, 0.22),
          transparent 60%
        ),
        var(--raised);
    }
    .services-cta h2 {
      margin: 0 0 8px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: clamp(1.5rem, 2.6vw, 2rem);
    }
    .services-cta p {
      margin: 0;
      color: var(--dim);
      font-size: 1.03rem;
    }
    @media (max-width: 800px) {
      .marina-services .band-head {
        grid-template-columns: 1fr;
        gap: 26px;
      }
      .approach-grid {
        grid-template-columns: 1fr;
        gap: 44px;
      }
    }
    @media (max-width: 560px) {
      .offer-grid {
        grid-template-columns: 1fr;
      }
      .services-cta {
        padding: 30px 24px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marina-services .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
  <script>
    const items = document.querySelectorAll('.marina-services .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }),
        { threshold: 0.12 },
      );
      items.forEach((item) => observer.observe(item));
    } else items.forEach((item) => item.classList.add('is-visible'));
  </script>
</BaseLayout>
