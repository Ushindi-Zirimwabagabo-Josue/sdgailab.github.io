---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import CmsText, { CmsList } from '../islands/CmsText';
const offers = [
  { section: 'offer-ai', icon: 'brain' },
  { section: 'offer-geo', icon: 'map' },
  { section: 'offer-data', icon: 'chart' },
  { section: 'offer-apps', icon: 'screen' },
  { section: 'offer-skills', icon: 'cap' },
  { section: 'offer-research', icon: 'search' },
  { section: 'offer-community', icon: 'people' },
  { section: 'offer-domain', icon: 'layers' },
];
const approaches = ['approach-1', 'approach-2', 'approach-3'];
---

<BaseLayout
  title="Services — SDG AI Lab"
  description="Eight practice areas from AI development to volunteer talent, mixed and matched per engagement."
>
  <main class="marina-services" id="main">
    <section class="band services-band" id="services">
      <div class="marina-live-wrap">
        <div class="band-head reveal">
          <h1><CmsText client:load page="services" section="heading" /></h1>
          <p><CmsText client:load page="services" section="intro" /></p>
        </div>
        <div class="offer-grid">
          {
            offers.map((offer, index) => (
              <article
                class="offer-card reveal"
                style={`--rd:${Math.min(index * 70, 420)}ms`}
              >
                <>
                  <div class="offer-icon" aria-hidden="true">
                    {offer.icon === 'brain' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2a3 3 0 0 0-3 3v1a3 3 0 0 0-2 2.8V10a3 3 0 0 0 0 5.9v1.3A3 3 0 0 0 9 20v1a3 3 0 0 0 6 0v-1a3 3 0 0 0 2-2.8v-1.3a3 3 0 0 0 0-5.9V8.8a3 3 0 0 0-2-2.8V5a3 3 0 0 0-3-3Z" />
                        <path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01" />
                      </svg>
                    )}
                    {offer.icon === 'map' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M9 20l-6-3V4l6 3 6-3 6 3v13l-6-3-6 3z" />
                        <path d="M9 4v13M15 7v13" />
                      </svg>
                    )}
                    {offer.icon === 'chart' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 3v18h18" />
                        <path d="M7 15l4-5 3 3 5-7" />
                      </svg>
                    )}
                    {offer.icon === 'screen' && (
                      <svg viewBox="0 0 24 24">
                        <rect x="4" y="3" width="16" height="14" rx="2" />
                        <path d="M9 21h6M12 17v4" />
                      </svg>
                    )}
                    {offer.icon === 'cap' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M22 10L12 5 2 10l10 5 10-5Z" />
                        <path d="M6 12v5c0 1.1 2.7 3 6 3s6-1.9 6-3v-5" />
                      </svg>
                    )}
                    {offer.icon === 'search' && (
                      <svg viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M21 21l-4.3-4.3" />
                      </svg>
                    )}
                    {offer.icon === 'people' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                    )}
                    {offer.icon === 'layers' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5" />
                      </svg>
                    )}
                  </div>
                  <h2><CmsText client:load page="services" section={`${offer.section}-title`} /></h2>
                  <CmsList client:load page="services" section={`${offer.section}-items`} />
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="band" id="approach">
      <div class="marina-live-wrap">
        <div class="band-head reveal">
          <h2><CmsText client:load page="services" section="approach-heading" /></h2>
          <p><CmsText client:load page="services" section="approach-intro" /></p>
        </div>
        <div class="approach-grid">
          {
            approaches.map((section, index) => (
              <article
                class="approach-cell reveal"
                style={`--rd:${index * 70}ms`}
              >
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3><CmsText client:load page="services" section={`${section}-title`} /></h3>
                  <p><CmsText client:load page="services" section={`${section}-body`} /></p>
                </>
              </article>
            ))
          }
        </div>
        <div class="services-cta reveal">
          <div>
            <h2><CmsText client:load page="services" section="cta-heading" /></h2>
            <p><CmsText client:load page="services" section="cta-body" /></p>
          </div>
          <a
            class="marina-button marina-button--primary"
            href={withBase('/contact')}>Contact</a
          >
        </div>
      </div>
    </section>
  </main>
  <style>
    .marina-services {
      --bg: #15181c;
      --raised: #1b1f24;
      --elevated: #21262c;
      --border: #2c323a;
      --soft: #24292f;
      --text: #d9dde2;
      --dim: #a0a8b2;
      --mid: #b7bfc7;
      --faint: #666f79;
      --teal: #0383ae;
      --blue: #1c61ac;
      --amber: #6ec6e8;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }
    .marina-services * {
      box-sizing: border-box;
    }
    .marina-services .band {
      padding: 56px 0;
      border-bottom: 1px solid var(--soft);
    }
    .marina-services .services-band {
      padding-top: 150px;
    }
    .marina-services .band-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      align-items: start;
      margin-bottom: 72px;
    }
    .marina-services .band-head h1,
    .marina-services .band-head h2 {
      margin: 0;
      background: linear-gradient(115deg, #fff 20%, #a8e6f5 55%, #26bde2 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: clamp(2.15rem, 4vw, 3.3rem);
      font-weight: 700;
      line-height: 1.06;
      letter-spacing: -0.03em;
    }
    .marina-services .band-head p {
      max-width: 460px;
      margin: 0;
      color: var(--mid);
      font-size: 1.02rem;
      line-height: 1.6;
    }
    .marina-services .reveal {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
      transition:
        opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--rd, 0ms);
    }
    .marina-services .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
    .offer-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-top: 46px;
    }
    .offer-card {
      display: flex;
      flex-direction: column;
      padding: 22px 20px 20px;
      border: 1px solid var(--soft);
      border-radius: 12px;
      background: var(--raised);
      transition:
        border-color 0.18s ease,
        transform 0.18s ease;
    }
    .offer-card:hover {
      border-color: var(--border);
      transform: translateY(-2px);
    }
    .offer-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      margin: 0 0 14px;
      color: var(--teal);
    }
    .offer-icon svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .offer-card h2 {
      margin: 0 0 14px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .offer-card :global(ul) {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .offer-card :global(li) {
      position: relative;
      padding-left: 14px;
      color: var(--dim);
      font-size: 0.82rem;
      line-height: 1.45;
      text-align: left;
    }
    .offer-card :global(li)::before {
      content: '';
      position: absolute;
      left: 0;
      top: 7px;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--faint);
    }
    .approach-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 56px;
    }
    .approach-cell {
      padding-top: 24px;
      border-top: 1px solid var(--soft);
      transition: border-color 0.25s ease;
    }
    .approach-cell:nth-child(1) {
      --approach-accent: #00689d;
    }
    .approach-cell:nth-child(2) {
      --approach-accent: #3f7e44;
    }
    .approach-cell:nth-child(3) {
      --approach-accent: #ff3a21;
    }
    .approach-cell:hover {
      border-top-color: var(--approach-accent, var(--teal));
    }
    .approach-cell > span {
      display: block;
      margin-bottom: 22px;
      color: var(--approach-accent, var(--teal));
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .approach-cell h3 {
      margin: 0 0 14px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: 1.18rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .approach-cell p {
      margin: 0;
      color: var(--dim);
      font-size: 0.94rem;
      line-height: 1.6;
    }
    .services-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      flex-wrap: wrap;
      margin-top: 56px;
      padding: 44px 48px;
      border: 1px solid var(--soft);
      border-radius: 18px;
      background:
        radial-gradient(
          900px 300px at 85% -40%,
          rgba(3, 131, 174, 0.22),
          transparent 60%
        ),
        var(--raised);
    }
    .services-cta h2 {
      margin: 0 0 8px;
      color: var(--text);
      font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
      font-size: clamp(1.5rem, 2.6vw, 2rem);
    }
    .services-cta p {
      margin: 0;
      color: var(--dim);
      font-size: 0.95rem;
    }
    @media (max-width: 980px) {
      .offer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 800px) {
      .marina-services .band-head {
        grid-template-columns: 1fr;
        gap: 26px;
      }
      .approach-grid {
        grid-template-columns: 1fr;
        gap: 44px;
      }
    }
    @media (max-width: 560px) {
      .offer-grid {
        grid-template-columns: 1fr;
      }
      .services-cta {
        padding: 30px 24px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marina-services .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
  <script>
    const items = document.querySelectorAll('.marina-services .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }),
        { threshold: 0.12 },
      );
      items.forEach((item) => observer.observe(item));
    } else items.forEach((item) => item.classList.add('is-visible'));
  </script>
</BaseLayout>
