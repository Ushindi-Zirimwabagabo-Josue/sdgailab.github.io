---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { withBase } from '../lib/url';

const programmes = [
  {
    image: 'prog-ftl.jpg',
    alt: 'Frontier Tech Leaders cohort in a training session',
    meta: 'Youth leadership · multi-country',
    title: 'Frontier & Future Tech Leaders Programme',
    description: 'Youth from Least Developed & Developing Countries trained in Machine Learning, Agentic AI, GeoAI, and entrepreneurship. 54% women participation.',
    result: '2,087 trained via FTL',
  },
  {
    image: 'prog-innovation-campus-ad.jpg',
    alt: 'Innovation Campus x Samsung recruitment campaign',
    meta: '436 graduates · since 2019',
    title: 'Innovation Campus',
    description: 'Now in its 11th phase — AI, IoT, Big Data and coding, delivered in Türkiye with Samsung. 90% employment rate and 52% women participation among graduates.',
    result: '30M worldwide reach',
  },
  {
    image: 'prog-gamedev.jpg',
    alt: 'Game Development Bootcamp participant at her setup',
    meta: '5,000 youth · UAE & Türkiye',
    title: 'Game Development Bootcamps',
    description: '18–35 year-olds trained in game dev, esports management and programming with HP, through a 4Cs framework. 72% women participation.',
    result: '50+ games developed',
  },
];
---
<BaseLayout title="Programmes — SDG AI Lab" description="Training programmes run by the SDG AI Lab — Frontier Tech Leaders, Innovation Campus, and Game Development Bootcamps.">
  <main class="marina-programmes" id="main">
    <section class="band" id="programmes">
      <div class="wrap">
        <div class="band-head reveal">
          <h1>Where digital skills training actually lands.</h1>
          <p>Three cohorts the Lab runs directly with partners, not one-off workshops. Looking for software instead? See the <a href={withBase('/projects')}>product portfolio &rarr;</a></p>
        </div>
        <div class="programme-grid">
          {programmes.map((programme) => (
            <article class="programme-card reveal">
              <div class="programme-photo"><img src={`https://sdg-dark.netlify.app/assets/${programme.image}`} alt={programme.alt} loading="lazy" decoding="async" /></div>
              <div class="programme-body">
                <span class="programme-meta">{programme.meta}</span>
                <h2>{programme.title}</h2>
                <p>{programme.description}</p>
                <a class="programme-more" href={withBase('/expertise#skills')}>{programme.result} &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <script>
    const items = document.querySelectorAll('.marina-programmes .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: .12 });
      items.forEach((item) => observer.observe(item));
    } else items.forEach((item) => item.classList.add('is-visible'));
  </script>
  <style is:global>
    .marina-programmes{--bg:#15181c;--bg-raised:#1b1f24;--bg-elevated:#21262c;--border:#2c323a;--border-soft:#24292f;--text:#d9dde2;--text-dim:#a0a8b2;--text-mid:#b7bfc7;--text-faint:#666f79;--teal:#0383ae;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif}
    .marina-programmes *{box-sizing:border-box}
    .marina-programmes .wrap{max-width:1280px;margin:0 auto;padding:0 40px}
    .marina-programmes .band{padding:150px 0 56px;border-bottom:1px solid var(--border-soft)}
    .marina-programmes .band-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;margin-bottom:72px}
    .marina-programmes .band-head h1{margin:0;background:linear-gradient(115deg,#fff 20%,#a8e6f5 55%,#26bde2 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;font-family:'Cabinet Grotesk','Inter',sans-serif;font-size:clamp(2.15rem,4vw,3.3rem);font-weight:700;line-height:1.06;letter-spacing:-.03em}
    .marina-programmes .band-head p{align-self:end;max-width:460px;margin:0;color:var(--text-mid);font-size:1.02rem;line-height:1.6}
    .marina-programmes .band-head a{color:var(--teal);font-weight:600;text-decoration:none}
    .marina-programmes .band-head a:hover,.marina-programmes .programme-more:hover{color:#6ec6e8}
    .marina-programmes .programme-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
    .marina-programmes .programme-card{overflow:hidden;border:1px solid var(--border-soft);border-radius:12px;background:var(--bg-raised);transition:transform .2s ease,border-color .2s ease}
    .marina-programmes .programme-card:hover{transform:translateY(-3px);border-color:var(--border)}
    .marina-programmes .programme-photo{aspect-ratio:16/10;overflow:hidden;background:var(--bg-elevated);border-bottom:1px solid var(--border-soft)}
    .marina-programmes .programme-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
    .marina-programmes .programme-card:hover img{transform:scale(1.03)}
    .marina-programmes .programme-body{padding:26px 24px 28px}
    .marina-programmes .programme-meta{display:block;margin-bottom:14px;color:var(--text-faint);font-size:.74rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
    .marina-programmes .programme-card h2{margin:0 0 12px;color:var(--text);font-family:'Cabinet Grotesk','Inter',sans-serif;font-size:1.02rem;font-weight:700;line-height:1.36}
    .marina-programmes .programme-card p{margin:0;color:var(--text-dim);font-size:.87rem;line-height:1.55}
    .marina-programmes .programme-more{display:inline-flex;margin-top:18px;color:var(--text-faint);font-size:.84rem;font-weight:600;text-decoration:none;transition:color .15s ease}
    .marina-programmes .reveal{opacity:0;transform:translateY(28px) scale(.985);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
    .marina-programmes .reveal.is-visible{opacity:1;transform:none}
    @media(max-width:900px){.marina-programmes .programme-grid{grid-template-columns:1fr}.marina-programmes .programme-photo{aspect-ratio:16/8}}
    @media(max-width:800px){.marina-programmes .band-head{grid-template-columns:1fr;gap:26px}}
    @media(max-width:560px){.marina-programmes .wrap{padding:0 20px}.marina-programmes .programme-photo{aspect-ratio:16/10}}
    @media(prefers-reduced-motion:reduce){.marina-programmes .reveal{opacity:1;transform:none;transition:none}}
  </style>
</BaseLayout>
