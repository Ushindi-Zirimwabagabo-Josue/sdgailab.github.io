---
import { withBase } from '../../lib/url';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PortfolioGrid from '../../islands/PortfolioGrid';
---

<BaseLayout
  title="Our Work - SDG AI Lab"
  description="Browse SDG AI Lab products, project portfolio, focus areas and implementation examples from seven years of delivery."
>
  <div class="marina-work-page" id="main">
    <section class="band" id="products" style="padding-top:150px;">
      <div class="wrap">
        <PortfolioGrid client:load />

        <p class="work-crosslink reveal">
          Looking for training and fellowships instead of software? See our <a
            href={withBase('/programmes')}>signature programmes &rarr;</a>
        </p>
      </div>
    </section>
  </div>
  <style is:global>
    .marina-work-page {
      --bg: #15181c;
      --bg-raised: #1b1f24;
      --bg-elevated: #21262c;
      --border: #2c323a;
      --border-soft: #24292f;
      --text: #d9dde2;
      --text-dim: #b7bfc7;
      --text-mid: #c5ccd4;
      --text-faint: #8d96a1;
      --teal: #0383ae;
      --blue: #1c61ac;
      --amber: #6ec6e8;
      --display: 'Cabinet Grotesk', sans-serif;
      --body: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      font-family: var(--body);
      line-height: 1.5;
      overflow-x: hidden;
    }

    .marina-work-page *,
    .marina-work-page *::before,
    .marina-work-page *::after {
      box-sizing: border-box;
    }
    .marina-work-page a {
      color: inherit;
      text-decoration: none;
    }
    .marina-work-page section[id] {
      scroll-margin-top: 84px;
    }

    .marina-work-page .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .marina-work-page h1,
    .marina-work-page h2,
    .marina-work-page h3 {
      font-family: var(--display);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
    }

    .marina-work-page .band {
      padding: 56px 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .marina-work-page .band-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      margin-bottom: 72px;
    }
    .marina-work-page .band-head h1 {
      background: linear-gradient(
        115deg,
        #ffffff 20%,
        #a8e6f5 55%,
        #26bde2 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      font-size: clamp(2.15rem, 4vw, 3.3rem);
      line-height: 1.06;
      letter-spacing: -0.03em;
      margin: 0;
    }
    .marina-work-page .band-head .desc {
      color: var(--text-mid);
      font-size: 1.02rem;
      line-height: 1.6;
      align-self: end;
      max-width: 460px;
      margin: 0;
    }

    .marina-work-page .portfolio-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 36px;
    }
    .marina-work-page .proj-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .marina-work-page .filter-dropdowns {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-left: auto;
    }
    .marina-work-page .filter-dropdown {
      position: relative;
    }
    .marina-work-page .filter-dropdown summary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border: 1px solid var(--border-soft);
      border-radius: 999px;
      background: transparent;
      color: var(--text-dim);
      font-size: 0.85rem;
      cursor: pointer;
      list-style: none;
      user-select: none;
      transition:
        border-color 0.15s ease,
        color 0.15s ease;
    }
    .marina-work-page .filter-dropdown summary::-webkit-details-marker {
      display: none;
    }
    .marina-work-page .filter-dropdown summary::after {
      content: '\25be';
      margin-left: 2px;
      color: var(--text-faint);
      font-size: 0.7rem;
    }
    .marina-work-page .filter-dropdown[open] summary::after {
      content: '\25b4';
    }
    .marina-work-page .filter-dropdown summary:hover {
      border-color: var(--text-faint);
      color: var(--text);
    }
    .marina-work-page .filter-current {
      color: var(--teal);
      font-weight: 600;
    }
    .marina-work-page .filter-panel {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      z-index: 30;
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 8px;
      width: max-content;
      min-width: 180px;
      max-width: min(280px, calc(100vw - 48px));
      max-height: min(320px, 50vh);
      overflow-x: hidden;
      overflow-y: auto;
      padding: 14px;
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      background: var(--bg-raised);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    }
    .marina-work-page .filter-dropdown--year .filter-panel {
      left: auto;
      right: 0;
    }
    .marina-work-page .filter-panel .status-btn {
      width: 100%;
      justify-content: flex-start;
      text-align: left;
    }
    .marina-work-page .status-btn,
    .marina-work-page .proj-filter {
      display: inline-flex;
      align-items: center;
      font-family: var(--body);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-dim);
      background: transparent;
      border: 1px solid var(--border-soft);
      border-radius: 100px;
      padding: 8px 16px;
      cursor: pointer;
      transition:
        color 0.15s ease,
        border-color 0.15s ease;
    }
    .marina-work-page .status-btn:hover,
    .marina-work-page .proj-filter:hover {
      border-color: var(--text-faint);
      color: var(--text);
    }
    .marina-work-page .status-btn.active,
    .marina-work-page .proj-filter.active {
      color: var(--teal);
      border-color: var(--teal);
    }

    .marina-work-page .portfolio-count {
      color: var(--text-faint);
      font-size: 0.86rem;
    }
    .marina-work-page .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .marina-work-page .portfolio-grid.is-empty::after {
      content: 'No published products match this filter yet.';
      color: var(--text-faint);
      font-size: 0.94rem;
      padding: 40px 4px;
      grid-column: 1/-1;
    }
    .marina-work-page .portfolio-card {
      display: flex;
      flex-direction: column;
      text-align: left;
      cursor: pointer;
      font-family: var(--body);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      overflow: hidden;
      background: var(--bg-raised);
      transition:
        border-color 0.18s ease,
        transform 0.18s ease;
    }
    .marina-work-page .portfolio-card:hover {
      border-color: var(--border);
      transform: translateY(-3px);
    }
    .marina-work-page .portfolio-card.is-hidden {
      display: none;
    }
    .marina-work-page .card-tile {
      overflow: hidden;
      background: var(--bg-elevated);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--border-soft);
    }
    .marina-work-page .card-tile img {
      width: 100%;
      height: auto;
      display: block;
      filter: saturate(0.9) contrast(0.95);
      transition: transform 0.4s ease;
    }
    .marina-work-page .portfolio-card:hover .card-tile img {
      transform: scale(1.035);
    }
    .marina-work-page .card-tile.is-generated {
      aspect-ratio: 4/3;
      background:
        repeating-linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.025) 0 2px,
          transparent 2px 30px
        ),
        var(--bg-elevated);
    }
    .marina-work-page .card-tile-code {
      font-family: var(--display);
      font-weight: 700;
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-faint);
    }
    .marina-work-page .card-body {
      padding: 22px 22px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .marina-work-page .card-meta {
      font-family: var(--body);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-faint);
      margin-bottom: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .marina-work-page .card-meta .status-live {
      color: var(--teal);
    }
    .marina-work-page .portfolio-card h2 {
      font-size: 1.02rem;
      margin-bottom: 10px;
      line-height: 1.34;
      color: var(--text);
    }
    .marina-work-page .card-body p {
      color: var(--text-dim);
      font-size: 0.86rem;
      line-height: 1.55;
      margin: 0 0 0;
      flex: 0 0 auto;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
      text-overflow: ellipsis;
      max-height: calc(1.55em * 3);
    }
    .marina-work-page .card-more {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-faint);
      margin-top: auto;
      padding-top: 18px;
      transition: color 0.15s ease;
    }
    .marina-work-page .portfolio-card:hover .card-more {
      color: var(--teal);
    }
    .marina-work-page .card-more svg {
      width: 14px;
      height: 14px;
      transition: transform 0.15s ease;
    }
    .marina-work-page .portfolio-card:hover .card-more svg {
      transform: translateX(3px);
    }
    .marina-work-page .work-crosslink {
      margin-top: 40px;
      padding-top: 28px;
      border-top: 1px solid var(--border-soft);
      font-size: 0.92rem;
      color: var(--text-dim);
    }
    .marina-work-page .work-crosslink a {
      color: var(--teal);
      font-weight: 600;
    }

    @media (max-width: 980px) {
      .marina-work-page .portfolio-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 800px) {
      .marina-work-page .band-head {
        grid-template-columns: 1fr;
        gap: 26px;
      }
    }
    @media (max-width: 640px) {
      .marina-work-page .wrap {
        padding: 0 20px;
      }
      .marina-work-page .portfolio-grid {
        grid-template-columns: 1fr;
      }
      .marina-work-page .filter-panel {
        max-width: 88vw;
      }
    }
  </style>
</BaseLayout>
