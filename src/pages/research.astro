---
import BaseLayout from '../components/layout/BaseLayout.astro';
import CmsText from '../islands/CmsText';
import ResearchOutputs from '../islands/ResearchOutputs';
---

<BaseLayout title="Research & Advisory - SDG AI Lab" description="Key outputs from SDG AI Lab technical assessments, advisory work and partnership facilitation.">
  <main class="marina-research" id="main">
    <section class="research-band" aria-labelledby="research-heading">
      <div class="marina-live-wrap">
        <div class="research-heading reveal">
          <h1 id="research-heading"><CmsText client:load page="research" section="heading" /></h1>
          <CmsText client:load page="research" section="intro" as="p" className="research-intro" />
        </div>

        <ResearchOutputs client:load />
      </div>
    </section>
  </main>

  <script>
    const reveals = document.querySelectorAll<HTMLElement>('.marina-research .reveal');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      reveals.forEach((element) => observer.observe(element));
    } else {
      reveals.forEach((element) => element.classList.add('is-visible'));
    }

  </script>

  <style is:global>
    .marina-research { background: #15181c; color: #d9dde2; font-family: 'Inter', sans-serif; min-height: 100vh; }
    .marina-research *, .marina-research *::before, .marina-research *::after { box-sizing: border-box; }
    .research-band { padding: 150px 0 80px; background: radial-gradient(650px 440px at 2% 28%, rgba(221, 157, 36, .055), transparent 68%), #15181c; }
    .research-heading { display: grid; grid-template-columns: .9fr 1.1fr; column-gap: 60px; align-items: start; }
    .research-heading h1 { max-width: 510px; margin: 0; font-family: 'Cabinet Grotesk', sans-serif; font-size: clamp(2.15rem, 4vw, 3.3rem); font-weight: 700; line-height: 1.06; letter-spacing: -.03em; background: linear-gradient(115deg, #fff 20%, #a8e6f5 55%, #26bde2 100%); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
    .research-intro { max-width: 460px; margin: 0; color: #b7bfc7; font-size: 1.02rem; line-height: 1.6; }
    .research-toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin: 72px 0 12px; }
    .research-toolbar--years { margin-top: 0; margin-bottom: 36px; }
    .research-outputs .research-toolbar:last-of-type { margin-bottom: 36px; }
    .research-filter { appearance: none; border: 1px solid #24292f; border-radius: 100px; background: #1b1f24; color: #a0a8b2; cursor: pointer; font: 600 .82rem 'Inter', sans-serif; padding: 8px 16px; transition: color .15s ease, border-color .15s ease, background .15s ease; }
    .research-filter:hover { border-color: #666f79; color: #d9dde2; }
    .research-filter.active { color: #0383ae; border-color: #0383ae; background: rgba(3, 131, 174, .12); }
    .output-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .output-card { display: flex; flex-direction: column; min-width: 0; padding: 0; border: 1px solid #24292f; border-radius: 14px; background: #1b1f24; transition: border-color .2s ease, transform .2s ease; overflow: hidden; }
    .output-card:hover { border-color: #2c323a; transform: translateY(-3px); }
    .output-link { display: flex; flex-direction: column; height: 100%; padding: 0; color: inherit; text-decoration: none; }
    .output-link-body { display: flex; flex: 1; flex-direction: column; padding: 18px; }
    .output-cover-tile { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid #24292f; background: #21262c; }
    .output-cover-tile img { display: block; width: 100%; height: auto; filter: saturate(.9) contrast(.95); transition: transform .4s ease; }
    .output-card:hover .output-cover-tile img { transform: scale(1.035); }
    .output-cover { position: relative; display: flex; align-items: flex-end; justify-content: flex-start; aspect-ratio: 4 / 3; overflow: hidden; padding: 16px; border-bottom: 1px solid #24292f; background: radial-gradient(120% 90% at 85% -10%, var(--cover-glow), transparent 60%), repeating-linear-gradient(135deg, rgba(255, 255, 255, .03) 0 2px, transparent 2px 26px), #21262c; }
    .output-cover--report { --cover-glow: rgba(253, 157, 36, .35); }
    .output-cover--brief_white_paper { --cover-glow: rgba(86, 192, 43, .35); }
    .output-cover--academic_paper { --cover-glow: rgba(38, 189, 226, .35); }
    .output-cover--dataset { --cover-glow: rgba(221, 19, 103, .35); }
    .output-cover span { position: relative; z-index: 1; color: #d9dde2; font-family: 'Cabinet Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.1; }
    .output-meta { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; color: #0383ae; font: 600 .68rem 'Inter', sans-serif; letter-spacing: .03em; text-transform: uppercase; }
    .output-meta span + span::before { content: '·'; margin-right: 5px; color: #666f79; }
    .output-card h2 { margin: 0; color: #d9dde2; font-family: 'Cabinet Grotesk', sans-serif; font-size: 1.12rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; }
    .output-card p { margin: 10px 0 0; color: #a0a8b2; font-size: .86rem; line-height: 1.55; text-align: justify; hyphens: auto; overflow-wrap: anywhere; }
    .output-more { display: inline-flex; margin-top: auto; padding-top: 18px; color: #a0a8b2; font: 600 .78rem 'Inter', sans-serif; }
    .output-link:hover .output-more { color: #26bde2; }
    .research-empty, .research-status { margin: 0 0 24px; color: #a0a8b2; }
    .reveal { opacity: 0; transform: translateY(28px) scale(.985); transition: opacity .9s cubic-bezier(.16, 1, .3, 1), transform .9s cubic-bezier(.16, 1, .3, 1); }
    .reveal.is-visible { opacity: 1; transform: none; }
    @media (max-width: 900px) { .research-heading { grid-template-columns: 1fr; row-gap: 38px; } .output-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .research-band { padding-top: 106px; padding-bottom: 56px; } .research-toolbar { margin-top: 42px; } .output-grid { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } .output-card { transition: none; } .output-cover-tile img { transition: none; } .output-card:hover .output-cover-tile img { transform: none; } }
  </style>
</BaseLayout>
