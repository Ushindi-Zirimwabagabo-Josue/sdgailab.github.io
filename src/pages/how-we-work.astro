---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';

const services = [
  ['01', 'Development', 'Custom digital solutions and applications.'],
  ['02', 'Research', 'Frontier technology research and analysis.'],
  ['03', 'Advisory', 'Technical guidance and strategic consulting.'],
  ['04', 'Training', 'Capacity building programmes and workshops.'],
  ['05', 'Partnerships', 'Facilitating collaboration with the tech sector.'],
];

const approach = [
  ['01', 'Agile software development', 'Short, iterative builds tested against the conditions a government system actually runs in — patchy connectivity, incomplete records, non-technical end users.'],
  ['02', 'Aligned with UNDP best practices', "Every deployment fits inside UNDP's standards for data, procurement, and partner handover, so the counterpart team can actually run it once we're gone."],
  ['03', 'Enhanced by AI', 'Agentic AI and machine learning applied where they remove real friction for the institutions we build with.'],
];
---

<BaseLayout
  title="How We Work - SDG AI Lab"
  description="How SDG AI Lab works with UNDP units and development partners through development, research, advisory, training and partnerships."
>
  <div class="marina-how-page" id="main">
    <section class="band first-band">
      <div class="wrap">
        <div class="band-head reveal">
          <span class="eyebrow" data-n="01">Our services</span>
          <h1>Five ways we work with UNDP units and development partners.</h1>
        </div>

        <div class="services-grid reveal">
          {services.map(([idx, title, body]) => (
            <article class="service-cell tilt">
              <span class="idx">{idx}</span>
              <div>
                <h2>{title}</h2>
                <p>{body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="approach">
      <div class="wrap">
        <div class="band-head reveal">
          <span class="eyebrow" data-n="02">How we work</span>
          <h2>Agile, aligned with UNDP practice, enhanced by AI.</h2>
          <p class="desc">Every engagement runs the same way, whether it's a two-week diagnostic or a year-long build: short cycles, work reviewed inside the counterpart institution as it happens, and a handover the team can actually operate without us.</p>
        </div>

        <div class="approach-grid">
          {approach.map(([idx, title, body]) => (
            <article class="approach-cell reveal">
              <span class="idx">{idx}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band" id="collaborate">
      <div class="wrap reveal">
        <span class="eyebrow" data-n="10">Partner with us</span>
        <h2>Four ways to build with SDG AI Lab.</h2>
        <p class="desc">Co-develop AI solutions &middot; Research &amp; policy advisory &middot; Build your team's capacity &middot; Access vetted tech talent &mdash; from prototype to deployment.</p>
        <div class="cta-actions">
          <a href={withBase('/contact')} class="btn btn-gradient btn-magnetic">Book a demo</a>
          <a href="mailto:dina.akylbekova@undp.org" class="btn btn-ghost">dina.akylbekova@undp.org</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .marina-how-page {
      --bg: #15181C;
      --bg-raised: #1B1F24;
      --bg-elevated: #21262C;
      --border: #2C323A;
      --border-soft: #24292F;
      --text: #D9DDE2;
      --text-dim: #8D96A1;
      --text-mid: #B7BFC7;
      --text-faint: #666F79;
      --teal: #22D3B8;
      --blue: #4C86FF;
      --amber: #FFAA3D;
      --display: 'Open Sans', sans-serif;
      --body: 'Open Sans', sans-serif;
      --mono: 'Open Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      font-family: var(--body);
      line-height: 1.5;
      overflow-x: hidden;
    }

    .marina-how-page *,
    .marina-how-page *::before,
    .marina-how-page *::after { box-sizing: border-box; }
    .marina-how-page a { color: inherit; text-decoration: none; }
    .marina-how-page section[id] { scroll-margin-top: 84px; }

    .marina-how-page .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .marina-how-page .eyebrow {
      font-family: var(--body);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-mid);
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .marina-how-page .eyebrow::before {
      content: attr(data-n);
      font-family: var(--display);
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--teal);
    }

    .marina-how-page h1,
    .marina-how-page h2,
    .marina-how-page h3 {
      font-family: var(--display);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
    }

    .marina-how-page .band {
      padding: 56px 0;
      border-bottom: 1px solid var(--border-soft);
    }

    .marina-how-page .first-band { padding-top: 150px; }

    .marina-how-page .band-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      margin-bottom: 72px;
    }

    .marina-how-page .band-head .eyebrow { grid-column: 1 / -1; }

    .marina-how-page .band-head h1,
    .marina-how-page .band-head h2 {
      font-size: clamp(1.9rem, 3.4vw, 2.7rem);
      line-height: 1.18;
      letter-spacing: -0.015em;
      margin-top: 22px;
    }

    .marina-how-page .band-head .desc {
      color: var(--text-mid);
      font-size: 1.02rem;
      line-height: 1.6;
      align-self: end;
      max-width: 460px;
      margin: 0;
    }

    .marina-how-page .services-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1px;
      background: var(--border-soft);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      overflow: hidden;
    }

    .marina-how-page .service-cell {
      background: var(--bg-raised);
      padding: 38px 30px;
      min-height: 212px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: background .25s ease, transform .25s ease;
    }

    .marina-how-page .service-cell::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--teal), var(--blue));
      opacity: .7;
      transition: opacity .25s ease;
    }

    .marina-how-page .service-cell:nth-child(3n+2)::before {
      background: linear-gradient(90deg, var(--blue), var(--amber));
    }

    .marina-how-page .service-cell:nth-child(3n+3)::before {
      background: linear-gradient(90deg, var(--amber), var(--teal));
    }

    .marina-how-page .service-cell:hover {
      background: var(--bg-elevated);
      transform: translateY(-3px);
    }

    .marina-how-page .service-cell:hover::before { opacity: 1; }

    .marina-how-page .service-cell .idx,
    .marina-how-page .approach-cell .idx {
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text-faint);
      display: block;
    }

    .marina-how-page .service-cell h2 {
      font-size: 1.02rem;
      margin-top: 16px;
    }

    .marina-how-page .service-cell p {
      color: var(--text-dim);
      font-size: 0.85rem;
      margin: 10px 0 0;
      line-height: 1.55;
    }

    .marina-how-page .approach-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 56px;
    }

    .marina-how-page .approach-cell {
      padding-top: 24px;
      border-top: 1px solid var(--border-soft);
      transition: border-color .25s ease;
    }

    .marina-how-page .approach-cell:hover { border-top-color: var(--teal); }
    .marina-how-page .approach-cell:hover .idx { color: var(--teal); }

    .marina-how-page .approach-cell .idx {
      margin-bottom: 22px;
      transition: color .25s ease;
    }

    .marina-how-page .approach-cell h3 {
      font-size: 1.18rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
    }

    .marina-how-page .approach-cell p {
      color: var(--text-dim);
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    .marina-how-page .cta-band {
      padding: 130px 0;
      text-align: center;
      position: relative;
      border-bottom: 1px solid var(--border-soft);
    }

    .marina-how-page .cta-band::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(680px 340px at 50% 0%, rgba(34, 211, 184, .07), transparent 70%),
        radial-gradient(480px 280px at 85% 30%, rgba(76, 134, 255, .05), transparent 70%);
    }

    .marina-how-page .cta-band .wrap {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .marina-how-page .cta-band .eyebrow { justify-content: center; }

    .marina-how-page .cta-band h2 {
      font-size: clamp(2.1rem, 4.6vw, 3.6rem);
      max-width: 820px;
      margin: 22px auto 34px;
      line-height: 1.08;
    }

    .marina-how-page .cta-band .desc {
      color: var(--text-dim);
      max-width: 520px;
      margin: 0 auto 40px;
      line-height: 1.65;
    }

    .marina-how-page .cta-actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .marina-how-page .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 100px;
      padding: 11px 22px;
      border: 1px solid transparent;
      font-weight: 650;
      font-size: 0.88rem;
      transition: box-shadow .2s ease, transform .2s ease, background .2s ease, border-color .2s ease;
    }

    .marina-how-page .btn:hover { transform: translateY(-1px); }

    .marina-how-page .btn-gradient {
      background: linear-gradient(100deg, var(--teal), var(--blue) 70%, var(--amber));
      color: #04141a;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, .08) inset, 0 8px 30px -8px rgba(34, 211, 184, .55);
    }

    .marina-how-page .btn-ghost {
      border-color: var(--border);
      background: transparent;
      color: var(--text);
    }

    .marina-how-page .btn-ghost:hover {
      border-color: var(--text-dim);
      background: rgba(255, 255, 255, .03);
    }

    @media (max-width: 980px) {
      .marina-how-page .services-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 800px) {
      .marina-how-page .band-head {
        grid-template-columns: 1fr;
        gap: 26px;
      }

      .marina-how-page .approach-grid {
        grid-template-columns: 1fr;
        gap: 44px;
      }
    }

    @media (max-width: 640px) {
      .marina-how-page .wrap { padding: 0 20px; }
      .marina-how-page .first-band { padding-top: 96px; }
    }

    @media (max-width: 520px) {
      .marina-how-page .services-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
