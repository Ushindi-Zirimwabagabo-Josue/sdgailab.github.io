---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import CmsText from '../islands/CmsText';
import TeamRoster from '../islands/TeamRoster';
const marinaAsset = (path: string) => `https://sdg-dark.netlify.app/${path}`;
const pillars = ['pillar-1', 'pillar-2', 'pillar-3', 'pillar-4'];
const timeline = [
  {
    year: '2019–2020',
    era: 'Foundations',
    image: 'assets/gis-satellite.jpg',
    alt: 'Early GIS piloting: satellite-based land and reef mapping',
    items: [
      ['nlp', 'NLP', 'SDGs Docs Analysis'],
      ['community', 'Community', 'Volunteer Data Scientists'],
      ['gis', 'GIS', 'Coral Reefs Mapping'],
    ],
  },
  {
    year: '2021',
    era: 'Scaling Tools',
    items: [
      ['gis', 'GIS', 'MSMEs Risk Exposure Map'],
      ['nlp', 'NLP', 'Resilience CSR Activities Analysis'],
      ['resilience', 'Resilience', 'GIS/NLP briefs'],
    ],
  },
  {
    year: '2022',
    era: 'Global Expansion',
    image: 'assets/dsvi-georgia-map.jpg',
    alt: 'Digital Social Vulnerability Index, first deployed in Georgia',
    items: [
      ['resilience', 'Resilience', 'FTR4DRR Launch'],
      ['gis', 'GIS', 'DSVI Launch'],
      ['nlp', 'NLP', 'AI Knowledge Base, SupTech'],
    ],
  },
  {
    year: '2023',
    era: 'Diversification',
    items: [
      ['gis', 'GIS', 'DSVI in 5 countries'],
      ['nlp', 'NLP', 'AI for Tourism'],
    ],
  },
  {
    year: '2024',
    era: 'Consolidation',
    image: 'assets/resilience-madagascar-dashboard.jpg',
    alt: 'Madagascar Multihazard Early Warning System dashboard',
    items: [
      [
        'nlp',
        'NLP',
        'Audit Tracking Tool (Fiji) · Public Finance Simplification (Pacific)',
      ],
      [
        'gis',
        'GIS',
        'DSVI Mainstreaming · Illegal Dumpsites Detection · Water Efficiency Calculations',
      ],
      ['resilience', 'Resilience', 'Madagascar DEWS · Tech4R Launch'],
    ],
  },
  {
    year: '2025',
    era: 'Innovation',
    image: 'assets/proj-tech4r.jpg',
    alt: 'Tech Volunteers for Resilience field work',
    items: [
      ['nlp', 'NLP', 'Value Chain Chatbot'],
      ['gis', 'GIS', 'Peace Index Map, DSVI'],
      ['resilience', 'Resilience', 'Tech4R special initiative'],
    ],
  },
  {
    year: '2026',
    era: 'Mainstreaming',
    items: [
      ['nlp', 'NLP', 'INFF Analysis tool · TMS chatbot'],
      ['gis', 'GIS', 'Peace Index Map · DSVI · Land Use'],
      ['resilience', 'Resilience', 'EWS'],
    ],
  },
];
---

<BaseLayout
  title="About — SDG AI Lab"
  description="Seven years of the SDG AI Lab — from first NLP and GIS pilots to a full AI, data and digital-skills practice inside UNDP."
>
  <main class="marina-about" id="main">
    <section class="marina-about-band marina-about-intro">
      <div class="marina-live-wrap">
        <div class="marina-about-head reveal">
          <h1>
            <CmsText client:load page="about" section="intro-heading" breaks />
          </h1>
          <p>
            <CmsText client:load page="about" section="intro-body" />
          </p>
        </div>
      </div>
    </section>
    <section class="marina-about-band">
      <div class="marina-live-wrap">
        <div class="marina-about-head reveal">
          <h2>
            <CmsText client:load page="about" section="pillars-heading" breaks />
          </h2>
          <p>
            <CmsText client:load page="about" section="pillars-intro" />
          </p>
        </div>
        <div class="marina-about-pillars">
          {
            pillars.map((section) => (
              <article class="marina-about-pillar reveal">
                <>
                  <h3><CmsText client:load page="about" section={`${section}-title`} /></h3>
                  <p><CmsText client:load page="about" section={`${section}-body`} /></p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="marina-about-band" id="evolution">
      <div class="marina-live-wrap">
        <!-- <div class="marina-about-head reveal">
          <h2>
            From first pilots <span>to a</span><br />mainstreamed<br />practice.
          </h2><p>
            One product line at a time, then several running in parallel across
            country offices.
          </p>
        </div>
        <div class="marina-about-timeline">
          <div class="marina-about-timeline-scroll">
            {
              timeline.map((entry, index) => (
                <article
                  class="marina-about-timeline-row reveal"
                  style={`--rd:${index * 70}ms`}
                >
                  <>
                    <span class="year">{entry.year}</span>
                    <div class="card">
                      <>
                        <div class="card-head">
                          <h3>{entry.era}</h3>
                          {entry.image && (
                            <div class="thumb">
                              <img
                                src={marinaAsset(entry.image)}
                                alt={entry.alt}
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                          )}
                        </div>
                        <ul>
                          {entry.items.map(([kind, label, copy]) => (
                            <li>
                              <span class={`tag ${kind}`}>{label}</span>
                              {copy}
                            </li>
                          ))}
                        </ul>
                      </>
                    </div>
                  </>
                </article>
              ))
            }
          </div>
        </div> -->
        <div class="marina-about-team reveal">
          <div class="marina-about-team-blurb">
            <h2><CmsText client:load page="about" section="team-heading" /></h2>
            <p><CmsText client:load page="about" section="team-body" /></p>
            <a href={withBase('/team')}><CmsText client:load page="about" section="team-link" /></a>
          </div>
          <TeamRoster client:load layout="compact" />
        </div>
      </div>
    </section>
    <section class="marina-about-band">
      <div class="marina-live-wrap">
        <div class="marina-about-cta reveal">
          <div>
            <h2><CmsText client:load page="about" section="cta-heading" /></h2>
            <p><CmsText client:load page="about" section="cta-body" /></p>
          </div><a
            class="marina-button marina-button--primary"
            href={withBase('/contact')}>Contact</a
          >
        </div>
      </div>
    </section>
  </main>
  <script>
    const items = document.querySelectorAll('.marina-about .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }),
        { threshold: 0.1 },
      );
      items.forEach((item) => observer.observe(item));
    } else items.forEach((item) => item.classList.add('is-visible'));
  </script>
</BaseLayout>
<style>
  .marina-about {
    background: #15181c;
    color: #d9dde2;
    overflow: hidden;
  }
  .marina-about * {
    box-sizing: border-box;
  }
  .marina-about-band {
    padding: 56px 0;
    border-bottom: 1px solid #24292f;
  }
  .marina-about-intro {
    padding-top: 132px;
  }
  .marina-about .reveal {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rd, 0ms);
  }
  .marina-about .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .marina-about-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
    margin-bottom: 72px;
  }
  .marina-about-intro .marina-about-head {
    margin-bottom: 0;
  }
  .marina-about-head h1,
  .marina-about-head h2 {
    margin: 0;
    background: linear-gradient(115deg, #fff 20%, #a8e6f5 55%, #26bde2 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
    font-size: clamp(2.15rem, 4vw, 3.3rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .marina-about-intro h1 {
    margin-top: 0;
  }
  .marina-about-head p {
    max-width: 460px;
    margin: 0;
    color: #b7bfc7;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .marina-about-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .marina-about-pillar {
    padding: 26px 24px;
    border: 1px solid #24292f;
    border-radius: 14px;
    background: #1b1f24;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }
  .marina-about-pillar:hover {
    transform: translateY(-2px);
    border-color: #2c323a;
  }
  .marina-about-pillar h3 {
    margin: 0 0 10px;
    color: #d9dde2;
    font-size: 0.98rem;
  }
  .marina-about-pillar p {
    margin: 0;
    color: #a0a8b2;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .marina-about-timeline {
    position: relative;
    margin-top: 48px;
  }
  .marina-about-timeline-scroll {
    display: flex;
    overflow-x: auto;
    padding: 12px 4px 28px;
    scroll-snap-type: x proximity;
  }
  .marina-about-timeline-scroll::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 34px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #0383ae, #1c61ac 55%, #6ec6e8);
    opacity: 0.45;
  }
  .marina-about-timeline-scroll::-webkit-scrollbar {
    height: 8px;
  }
  .marina-about-timeline-scroll::-webkit-scrollbar-thumb {
    border-radius: 8px;
    background: #24292f;
  }
  .marina-about-timeline-row {
    position: relative;
    flex: 0 0 280px;
    padding: 34px 22px 0 0;
    scroll-snap-align: start;
  }
  .marina-about-timeline-row:last-child {
    padding-right: 4px;
  }
  .marina-about-timeline-row::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 0;
    top: 27px;
    width: 16px;
    height: 16px;
    border: 3px solid #0383ae;
    border-radius: 50%;
    background: #15181c;
  }
  .marina-about-timeline-row .year {
    position: absolute;
    left: 0;
    top: 0;
    color: #d9dde2;
    font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
    font-size: 1.28rem;
    font-weight: 800;
  }
  .marina-about-timeline-row .card {
    height: 100%;
    padding: 20px 22px;
    border: 1px solid #24292f;
    border-radius: 14px;
    background: #1b1f24;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .marina-about-timeline-row .card:hover {
    border-color: #0383ae;
    transform: translateY(-3px);
  }
  .marina-about-timeline-row .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }
  .marina-about-timeline-row h3 {
    margin: 0;
    color: #d9dde2;
    font-size: 1.05rem;
  }
  .marina-about-timeline-row .thumb {
    width: 100%;
    height: 110px;
    flex-shrink: 0;
    overflow: hidden;
    margin-bottom: 14px;
    border: 1px solid #24292f;
    border-radius: 12px;
  }
  .marina-about-timeline-row .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .marina-about-timeline-row ul {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marina-about-timeline-row li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #a0a8b2;
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .marina-about-timeline-row .tag {
    flex-shrink: 0;
    margin-top: 2px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .tag.nlp {
    background: rgba(3, 131, 174, 0.16);
    color: #7fd0ec;
  }
  .tag.gis {
    background: rgba(28, 97, 172, 0.22);
    color: #9dbfe8;
  }
  .tag.resilience {
    background: rgba(110, 198, 232, 0.12);
    color: #b2dff4;
  }
  .tag.community {
    background: rgba(221, 19, 103, 0.16);
    color: #f291c0;
  }
  .marina-about-team {
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) 1.6fr;
    gap: 40px 48px;
    align-items: start;
  }
  .marina-about-team-blurb h2 {
    margin: 0;
    color: #d9dde2;
    font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .marina-about-team-blurb p {
    margin: 14px 0 0;
    max-width: 28ch;
    color: #a0a8b2;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .marina-about-team-blurb a {
    display: inline-block;
    margin-top: 18px;
    color: #0383ae;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .marina-about-team-blurb a:hover {
    color: #6ec6e8;
  }
  .marina-about-team :global(.roster) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px 18px;
  }
  .marina-about-team :global(.roster article) {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .marina-about-team :global(.roster img),
  .marina-about-team :global(.roster-avatar-fallback) {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }
  .marina-about-team :global(.roster-avatar-fallback) {
    display: block;
    background: #24292f;
  }
  .marina-about-team :global(.roster strong),
  .marina-about-team :global(.roster small) {
    display: block;
  }
  .marina-about-team :global(.roster strong) {
    font-size: 0.82rem;
    line-height: 1.25;
  }
  .marina-about-team :global(.roster small) {
    color: #a0a8b2;
    font-size: 0.72rem;
    line-height: 1.3;
  }
  .marina-about-team :global(.team-status) {
    color: #a0a8b2;
    font-size: 0.9rem;
  }
  .marina-about-team :global(.team-spinner) {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    border: 2px solid rgba(3, 131, 174, 0.25);
    border-top-color: #0383ae;
    animation: marina-about-spin 0.8s linear infinite;
  }
  @keyframes marina-about-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .marina-about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    padding: 44px 48px;
    border: 1px solid #24292f;
    border-radius: 18px;
    background:
      radial-gradient(
        900px 300px at 85% -40%,
        rgba(3, 131, 174, 0.22),
        transparent 60%
      ),
      #1b1f24;
  }
  .marina-about-cta h2 {
    margin: 0 0 8px;
    color: #d9dde2;
    font-family: 'Cabinet Grotesk', 'Inter', sans-serif;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .marina-about-cta p {
    margin: 0;
    color: #a0a8b2;
    font-size: 0.95rem;
  }
  @media (max-width: 980px) {
    .marina-about-pillars {
      grid-template-columns: repeat(2, 1fr);
    }
    .marina-about-team {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .marina-about-team-blurb p {
      max-width: 42ch;
    }
  }
  @media (max-width: 900px) {
    .marina-about-team :global(.roster) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 800px) {
    .marina-about-head {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
  @media (max-width: 680px) {
    .marina-about-timeline-scroll {
      flex-direction: column;
      overflow: visible;
      gap: 26px;
      padding-top: 8px;
    }
    .marina-about-timeline-scroll::before,
    .marina-about-timeline-row::before {
      display: none;
    }
    .marina-about-timeline-row {
      width: 100%;
      flex-basis: auto;
      padding: 0;
    }
    .marina-about-timeline-row .year {
      position: static;
      display: block;
      margin-bottom: 12px;
    }
    .marina-about-timeline-row .card {
      height: auto;
    }
    .marina-about-timeline-row .card-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .marina-about-pillars,
    .marina-about-team :global(.roster) {
      grid-template-columns: 1fr;
    }
    .marina-about-cta {
      padding: 30px 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marina-about .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
