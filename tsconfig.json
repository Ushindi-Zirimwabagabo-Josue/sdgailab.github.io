{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@islands/*": ["src/islands/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "e2e",
    "tests",
    "src/test",
    "assets",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
